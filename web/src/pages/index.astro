---
import '../dashboard.css';
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="joule Job dashboard" /><title>joule · Triage</title><link rel="icon" href="data:," /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Inter+Tight:wght@700;800&amp;family=JetBrains+Mono:wght@400;500;600&amp;display=swap" rel="stylesheet" /><script is:inline>
      try {
        const appearance = JSON.parse(localStorage.getItem('joule.appearance') || '{}');
        if (['system', 'light', 'dark'].includes(appearance.theme)) document.documentElement.dataset.theme = appearance.theme;
        if (['compact', 'comfortable'].includes(appearance.density)) document.documentElement.dataset.density = appearance.density;
      } catch { /* The default follows the system; the server preference loads after startup. */ }
    </script></head>
  <body>
    <header class="app-header"><a class="brand" href="/">joule<span class="brand-dot">.</span></a><nav class="app-nav" aria-label="Main"><a href="#triage" data-view="triage" aria-current="page">Triage</a><a href="#pipeline" data-view="pipeline">Pipeline <span data-pipeline-count title="Active Pipeline Jobs">—</span></a><a href="#scans" data-view="scans">Scans <kbd>s</kbd></a></nav><a id="scan-status" class="scan-status" href="#scans" data-view="scans">Loading Scans…</a><label id="job-search-box" class="triage-search"><span class="sr-only">Filter Jobs by title, company or reason</span><input id="job-search" type="search" placeholder="Filter by title, company, reason" autocomplete="off" /><kbd>/</kbd></label><a id="settings-link" href="#settings" data-view="settings">Settings <kbd>,</kbd></a><button class="fill-trigger" data-open-fill aria-haspopup="dialog" aria-controls="fill-dialog">Fill a Job <kbd>n</kbd></button><button id="show-shortcuts" aria-label="All shortcuts">?</button></header>
    <main id="dashboard">
      <section id="triage" aria-label="Triage" tabindex="-1">
        <details id="triage-filters" open><summary><span id="split-summary"></span><span>Filters ▾</span></summary><div class="controls" aria-label="Filters"><select id="triage-view" class="chip" aria-label="Triage view"><option value="inbox">Inbox</option></select><button id="fit-filter" class="chip" aria-pressed="false" aria-label="Add Fit Score ≥ 90 filter">+ Fit ≥ 90</button><span class="show-label">Show</span><label><input type="checkbox" name="new" checked /> New <span data-count="new">—</span></label><label><input type="checkbox" name="unscored" checked /> Unscored <span data-count="unscored">—</span></label><label><input type="checkbox" name="filtered" /> Filtered <span data-count="filtered">—</span></label><label><input type="checkbox" name="applied" /> Applied <span data-count="applied">—</span></label><label><input type="checkbox" name="dismissed" /> Dismissed <span data-count="dismissed">—</span></label><button id="sources-button" class="chip" popovertarget="sources-menu" aria-haspopup="dialog" aria-expanded="false" aria-controls="sources-menu">Sources <span id="source-count">—</span> <span class="source-caret" aria-hidden="true">▾</span> <kbd>f</kbd></button><section id="sources-menu" popover="auto" role="dialog" aria-label="Sources"><span id="mobile-source-count" class="mobile-only">Sources</span><label class="source-search"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg><input id="source-search" type="search" aria-label="Find a Source" placeholder="Find a Source" autocomplete="off" autofocus /></label><div class="source-bulk"><button class="btn small" data-pick="all">All</button><button class="btn small" data-pick="none">None</button><button class="btn small" data-pick="new">With new Jobs</button><span>sorted by new Jobs</span></div><div id="source-options" role="group" aria-label="Source choices"></div><footer class="source-footer"><span><kbd>j</kbd> <kbd>k</kbd> move</span><span><kbd>space</kbd> toggle</span><span><kbd>o</kbd> only</span><a href="#scans">Scans ›</a></footer></section><span id="job-count"></span><select id="job-sort" aria-label="Sort Jobs"><option value="rank">Rank ↓</option><option value="score">Fit Score ↓</option><option value="newest">Newest ↓</option></select><button id="score-all" data-action="score-all" disabled>Score all</button><button id="dismiss-below" title="Dismiss new/seen Jobs below 70, excluding Filtered" data-action="dismiss-below" disabled>Dismiss below 70</button></div></details>
        <button id="mobile-filter-open" class="mobile-only" aria-haspopup="dialog">Filters</button><p class="mobile-only mobile-list-caption"><span id="mobile-job-count"></span><span>swipe ← dismiss · applied →</span></p>
        <div id="jobs" class="table-wrap" aria-label="Jobs" aria-busy="true"><span class="sr-only">Loading Jobs…</span>{Array.from({length: 5}, () => <div class="loading-row" aria-hidden="true"><span class="skeleton loading-score"></span><span class="loading-copy"><span class="skeleton"></span><span class="skeleton"></span></span></div>)}</div>
        <footer class="keyboard-hint"><span id="row-position">Row 0 of 0</span><span class="key-hints"><span><kbd>j</kbd> <kbd>k</kbd> move</span><span><kbd>o</kbd> open</span><span><kbd>d</kbd> dismiss / restore</span><span><kbd>a</kbd> applied</span><span><kbd>x</kbd> select</span><span><kbd>/</kbd> search</span><span><kbd>z</kbd> undo</span><span><kbd>f</kbd> Sources</span><span><kbd>s</kbd> Scans</span><span><kbd>Esc</kbd> clear / close</span><span><kbd>?</kbd> all</span></span></footer>
      </section>
      <section id="a-pipeline" aria-label="Pipeline" tabindex="-1" hidden></section>
      <section id="a-scans" tabindex="-1" aria-label="Scans" hidden><p class="empty">Loading Sources…</p></section>
      <section id="a-settings" aria-label="Settings" tabindex="-1" hidden></section>
      <dialog id="fill-dialog" aria-labelledby="fill-title"></dialog>
      <div id="detail"></div>
      <dialog id="mobile-filters" aria-label="Filters"><header><h2 tabindex="-1" autofocus>Filters</h2><button data-action="clear-filters">Reset</button><button data-mobile-close aria-label="Close filters">×</button></header><div id="mobile-filter-content"></div><footer><button id="mobile-show-jobs" class="btn primary" data-mobile-close>Show Jobs</button></footer></dialog>
      <nav id="mobile-nav" class="mobile-only" aria-label="Main"><a href="#triage" data-view="triage" aria-current="page"><span aria-hidden="true">☰</span>Triage</a><a href="#pipeline" data-view="pipeline"><span aria-hidden="true">▥</span>Pipeline</a><a href="#scans" data-view="scans"><span aria-hidden="true">⟳</span>Scans</a><button data-open-fill aria-haspopup="dialog" aria-controls="fill-dialog"><span aria-hidden="true">＋</span>Fill</button></nav>
      <div id="bulk-actions" role="toolbar" aria-label="Bulk actions" hidden><b id="selected-count"></b><button data-action="bulk-state" data-state="dismissed"><kbd>d</kbd> Dismiss</button><button data-action="bulk-state" data-state="applied"><kbd>a</kbd> Applied</button><button id="bulk-score" data-action="bulk-score">Score</button><button data-action="clear-selection">Clear <kbd>Esc</kbd></button></div>
      <div id="undo-toast" role="status" aria-live="polite" hidden><span></span><button data-action="undo">Undo <kbd>z</kbd></button></div>
      <dialog id="shortcuts" aria-labelledby="shortcuts-title"><header><h2 id="shortcuts-title">Keyboard shortcuts</h2><button id="close-shortcuts" aria-label="Close shortcuts" autofocus>×</button></header><dl><dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>Next / previous Job</dd><dt><kbd>o</kbd></dt><dd>Open Job</dd><dt><kbd>d</kbd></dt><dd>Dismiss / restore; Dismiss selected Jobs</dd><dt><kbd>a</kbd></dt><dd>Applied / unmark; Apply selected Jobs</dd><dt><kbd>x</kbd></dt><dd>Select / deselect cursor row</dd><dt><kbd>/</kbd></dt><dd>Search Triage</dd><dt><kbd>z</kbd></dt><dd>Undo last state change</dd><dt><kbd>f</kbd></dt><dd>Sources (phone: Filters)</dd><dt><kbd>,</kbd></dt><dd>Settings</dd><dt><kbd>n</kbd></dt><dd>Fill a Job</dd><dt><kbd>p</kbd></dt><dd>Open Pipeline</dd><dt><kbd>s</kbd></dt><dd>Open Scans</dd><dt><kbd>v</kbd></dt><dd>Pipeline: show / hide flow</dd><dt><kbd>h</kbd> <kbd>l</kbd></dt><dd>Pipeline: previous / next column</dd><dt><kbd>[</kbd> <kbd>]</kbd></dt><dd>Pipeline: move back / on</dd><dt><kbd>x</kbd> / <kbd>e</kbd></dt><dd>Pipeline: close as… / date or note</dd><dt><kbd>Esc</kbd></dt><dd>Clear selection, then close drawer / menu / dialog; Scans / Settings → Triage</dd><dt><kbd>1</kbd>–<kbd>5</kbd></dt><dd>Drawer: Fit, Pipeline (applied Jobs), Draft, CV, Ask</dd><dt><kbd>c</kbd></dt><dd>Copy Draft</dd><dt><kbd>?</kbd></dt><dd>All shortcuts</dd></dl><p class="muted">Sources: ↑ / ↓ or j / k move, Home / End jump, Space toggles, o shows only the focused Source. Shortcuts pause while typing.</p></dialog>
      <noscript><p>Enable JavaScript to load Jobs and run Scans.</p></noscript>
    </main><div id="notice" role="status" aria-live="polite"></div>
    <script>import '../dashboard'; import '../manual';</script>
  </body>
</html>
