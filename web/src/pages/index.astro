---
import '../dashboard.css';
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="joule Job dashboard" /><title>joule · Triage</title><link rel="icon" href="data:," /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Inter+Tight:wght@700;800&amp;family=JetBrains+Mono:wght@400;500;600&amp;display=swap" rel="stylesheet" /></head>
  <body>
    <header class="app-header"><a class="brand" href="/">joule<span class="brand-dot">.</span></a><nav class="app-nav" aria-label="Main"><a href="#triage" data-view="triage" aria-current="page">Triage</a><a href="#scans" data-view="scans">Scans <kbd>s</kbd></a></nav><a id="scan-status" class="scan-status" href="#scans" data-view="scans">Loading Scans…</a></header>
    <main id="dashboard">
      <section id="triage" aria-label="Triage" tabindex="-1">
        <details id="triage-filters" open><summary><span id="split-summary"></span><span>Filters ▾</span></summary><div class="controls" aria-label="Filters"><span class="show-label">Show</span><label><input type="checkbox" name="new" checked /> New <span data-count="new">—</span></label><label><input type="checkbox" name="unscored" checked /> Unscored <span data-count="unscored">—</span></label><label><input type="checkbox" name="filtered" /> Filtered <span data-count="filtered">—</span></label><label><input type="checkbox" name="applied" /> Applied <span data-count="applied">—</span></label><label><input type="checkbox" name="dismissed" /> Dismissed <span data-count="dismissed">—</span></label><button id="sources-button" class="chip" popovertarget="sources-menu" aria-haspopup="dialog" aria-expanded="false" aria-controls="sources-menu">Sources <span id="source-count">—</span> <span class="source-caret" aria-hidden="true">▾</span> <kbd>f</kbd></button><section id="sources-menu" popover="auto" role="dialog" aria-label="Sources"><span id="mobile-source-count" class="mobile-only">Sources</span><label class="source-search"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg><input id="source-search" type="search" aria-label="Find a Source" placeholder="Find a Source" autocomplete="off" autofocus /></label><div class="source-bulk"><button class="btn small" data-pick="all">All</button><button class="btn small" data-pick="none">None</button><button class="btn small" data-pick="new">With new Jobs</button><span>sorted by new Jobs</span></div><div id="source-options" role="group" aria-label="Source choices"></div><footer class="source-footer"><span><kbd>j</kbd> <kbd>k</kbd> move</span><span><kbd>space</kbd> toggle</span><span><kbd>o</kbd> only</span><a href="#scans">Scans ›</a></footer></section><span id="job-count"></span><button class="btn" data-action="sort" id="job-sort" aria-pressed="false" title="Sort by rank or Fit Score">Rank ↓</button><button id="score-all" data-action="score-all" disabled>Score all</button></div></details>
        <button id="mobile-filter-open" class="mobile-only" aria-haspopup="dialog">Filters</button><p class="mobile-only mobile-list-caption"><span id="mobile-job-count"></span><span>swipe ← dismiss · applied →</span></p>
        <div id="jobs" class="table-wrap" aria-label="Jobs" aria-busy="true"><span class="sr-only">Loading Jobs…</span>{Array.from({length: 5}, () => <div class="loading-row" aria-hidden="true"><span class="skeleton loading-score"></span><span class="loading-copy"><span class="skeleton"></span><span class="skeleton"></span></span></div>)}</div>
        <footer class="keyboard-hint"><span id="row-position">Row 0 of 0</span><span class="key-hints"><span><kbd>j</kbd> <kbd>k</kbd> move</span><span><kbd>o</kbd> open</span><span><kbd>d</kbd> dismiss / restore</span><span><kbd>a</kbd> applied</span><span><kbd>f</kbd> Sources</span><span><kbd>s</kbd> Scans</span><span><kbd>Esc</kbd> close</span></span></footer>
      </section>
      <section id="a-scans" tabindex="-1" aria-label="Scans" hidden><p class="empty">Loading Sources…</p></section>
      <details id="manual-panel"><summary>Manual input</summary><section id="manual" class="job-content draft" aria-label="Manual input"></section></details>
      <div id="detail"></div>
      <dialog id="mobile-filters" aria-label="Filters"><header><h2 tabindex="-1" autofocus>Filters</h2><button data-action="clear-filters">Reset</button><button data-mobile-close aria-label="Close filters">×</button></header><div id="mobile-filter-content"></div><footer><button id="mobile-show-jobs" class="btn primary" data-mobile-close>Show Jobs</button></footer></dialog>
      <nav id="mobile-nav" class="mobile-only" aria-label="Main"><a href="#triage" data-view="triage" aria-current="page"><span aria-hidden="true">☰</span>Triage</a><a href="#scans" data-view="scans"><span aria-hidden="true">⟳</span>Scans</a></nav>
      <noscript><p>Enable JavaScript to load Jobs and run Scans.</p></noscript>
    </main><div id="notice" role="status" aria-live="polite"></div>
    <script>import '../dashboard'; import '../manual';</script>
  </body>
</html>
