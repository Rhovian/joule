---
import '../dashboard.css';
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="joule Job dashboard" /><title>joule · Triage</title><link rel="icon" href="data:," /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Inter+Tight:wght@700;800&amp;family=JetBrains+Mono:wght@400;500;600&amp;display=swap" rel="stylesheet" /></head>
  <body>
    <header class="app-header"><a class="brand" href="/">joule<span class="brand-dot">.</span></a><nav class="app-nav" aria-label="Main"><a href="#triage" data-view="triage" aria-current="page">Triage</a><a href="#scans" data-view="scans">Scans <kbd>s</kbd></a></nav><a id="scan-status" class="scan-status" href="#scans" data-view="scans">Loading Scans…</a></header>
    <main id="dashboard">
      <section id="triage" aria-label="Triage" tabindex="-1">
        <div class="controls" aria-label="Filters"><span class="show-label">Show</span><label><input type="checkbox" name="new" checked /> New <span data-count="new">—</span></label><label><input type="checkbox" name="unscored" checked /> Unscored <span data-count="unscored">—</span></label><label><input type="checkbox" name="filtered" /> Filtered <span data-count="filtered">—</span></label><label><input type="checkbox" name="applied" /> Applied <span data-count="applied">—</span></label><label><input type="checkbox" name="dismissed" /> Dismissed <span data-count="dismissed">—</span></label><details class="source-filter"><summary class="chip">Sources <span id="source-count">—</span> ▾</summary><fieldset class="source-picks" aria-label="Sources"></fieldset></details><span id="job-count"></span><button class="btn" data-action="sort" id="job-sort" aria-pressed="false" title="Sort by rank or Fit Score">Rank ↓</button><button id="score-all" data-action="score-all" disabled>Score all</button></div>
        <div id="jobs" class="table-wrap" aria-label="Jobs" aria-busy="true"><span class="sr-only">Loading Jobs…</span>{Array.from({length: 5}, () => <div class="loading-row" aria-hidden="true"><span class="skeleton loading-score"></span><span class="loading-copy"><span class="skeleton"></span><span class="skeleton"></span></span></div>)}</div>
        <footer class="keyboard-hint"><span id="row-position">Row 0 of 0</span><span class="key-hints"><span><kbd>j</kbd> <kbd>k</kbd> move</span><span><kbd>o</kbd> open</span><span><kbd>d</kbd> dismiss / restore</span><span><kbd>a</kbd> applied</span><span><kbd>s</kbd> Scans</span><span><kbd>Esc</kbd> close</span></span></footer>
      </section>
      <section id="a-scans" tabindex="-1" aria-label="Scans" hidden><p class="empty">Loading Sources…</p></section>
      <details id="manual-panel"><summary>Manual input</summary><section id="manual" class="job-content draft" aria-label="Manual input"></section></details>
      <div id="detail"></div>
      <noscript><p>Enable JavaScript to load Jobs and run Scans.</p></noscript>
    </main><div id="notice" role="status" aria-live="polite"></div>
    <script>import '../dashboard'; import '../manual';</script>
  </body>
</html>
